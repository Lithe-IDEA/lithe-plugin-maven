{
  "schemaVersion": 2,
  "id": "io.github.lithe-idea.maven-build",
  "displayName": "Maven",
  "version": "0.1.3",
  "pluginAPIVersion": 3,
  "requires": { "backend": 2, "buildProviders": 1, "buildSystems": 1, "pluginFunctions": 1, "projectGenerators": 1, "serverProcess": 1 },
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": ["backend.launch", "languageServer.launch", "process.build", "project.generate", "workspace.metadata"],
  "activationEvents": ["onBuildSystem:maven"],
  "languages": [],
  "backend": {
    "launch": { "kind": "runtime", "tool": "java", "minimumVersion": "8", "entry": "lib/lithe-maven-backend.jar" },
    "arguments": ["--plugin-backend"]
  },
  "pluginFunctions": {
    "exports": [{ "id": "languageImport.settings", "version": 1, "context": "workspace" }]
  },
  "buildSystems": [
    {
      "id": "maven",
      "displayName": "Maven",
      "icon": { "path": "icons/maven.svg" },
      "detection": {
        "markers": ["pom.xml"],
        "nesting": "outermost"
      },
      "invocation": {
        "executables": [
          {
            "kind": "projectFile",
            "path": "mvnw",
            "requires": [".mvn/wrapper/maven-wrapper.properties"],
            "platforms": ["macos", "linux"]
          },
          {
            "kind": "projectFile",
            "path": "mvnw.cmd",
            "requires": [".mvn/wrapper/maven-wrapper.properties"],
            "platforms": ["windows"]
          },
          { "kind": "environment", "variable": "MAVEN_HOME", "path": "bin/mvn", "platforms": ["macos", "linux"] },
          { "kind": "environment", "variable": "MAVEN_HOME", "path": "bin/mvn.cmd", "platforms": ["windows"] },
          { "kind": "command", "command": "mvn" }
        ],
        "environmentInputs": ["MAVEN_HOME"],
        "runtimeDependencies": [{ "id": "java", "minimumVersion": "8" }],
        "globalArguments": [
          "-B",
          "-ntp",
          "${optionArguments:profiles}",
          "${optionArguments:settingsFile}",
          "${optionArguments:localRepository}",
          "${optionArguments:offline}"
        ],
        "version": { "arguments": ["--version"], "pattern": "Apache Maven (\\d+\\.\\d+\\.\\d+)" },
        "minimumVersion": "3.6.3"
      },
      "options": [
        {
          "id": "profiles",
          "displayName": "Profiles",
          "kind": "multiSelect",
          "choicesFromModel": true,
          "allowCustom": true,
          "presentation": "tree",
          "arguments": ["-P", "${value}"]
        },
        { "id": "settingsFile", "displayName": "Settings File", "kind": "file", "arguments": ["-s", "${value}"] },
        {
          "id": "localRepository",
          "displayName": "Local Repository",
          "kind": "directory",
          "arguments": ["-Dmaven.repo.local=${value}"]
        },
        {
          "id": "offline",
          "displayName": "Offline",
          "kind": "boolean",
          "presentation": "toolbar",
          "icon": { "path": "icons/offline.svg" },
          "arguments": ["-o"]
        },
        {
          "id": "skipTests",
          "displayName": "Skip Tests",
          "kind": "boolean",
          "presentation": "toolbar",
          "icon": { "path": "icons/skipTests.svg" },
          "arguments": ["-DskipTests"]
        }
      ],
      "provider": {
        "launch": {
          "kind": "runtime",
          "tool": "java",
          "minimumVersion": "8",
          "entry": "lib/lithe-maven-backend.jar"
        },
        "arguments": ["--state", "${workspaceStateDir}"],
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "model": { "source": "provider" },
      "tasks": [
        {
          "id": "clean",
          "displayName": "clean",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "clean"
          ]
        },
        {
          "id": "validate",
          "displayName": "validate",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "validate"
          ]
        },
        {
          "id": "compile",
          "displayName": "compile",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "compile"
          ]
        },
        {
          "id": "test",
          "displayName": "test",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "test"
          ]
        },
        {
          "id": "package",
          "displayName": "package",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "package"
          ]
        },
        {
          "id": "verify",
          "displayName": "verify",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "verify"
          ]
        },
        {
          "id": "install",
          "displayName": "install",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "install"
          ]
        },
        {
          "id": "site",
          "displayName": "site",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "site"
          ]
        },
        {
          "id": "deploy",
          "displayName": "deploy",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "deploy"
          ]
        },
        {
          "id": "plugin-goal",
          "displayName": "Plugin Goal",
          "group": "build",
          "category": ["Plugins"],
          "fromModel": true,
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "${task.property:goal}"
          ]
        },
        {
          "id": "goal",
          "displayName": "Run Maven Goal…",
          "group": "other",
          "scopes": ["workspace", "project"],
          "requiresUserArguments": true,
          "arguments": [
            { "value": "-pl", "when": "nestedProjectSelected" },
            { "value": "${project.path}", "when": "nestedProjectSelected" },
            "${optionArguments:skipTests}",
            "${userArguments}"
          ]
        }
      ],
      "test": {
        "scopes": ["workspace", "project"],
        "filters": ["suite", "case"],
        "arguments": [
          { "value": "-pl", "when": "nestedProjectSelected" },
          { "value": "${project.path}", "when": "nestedProjectSelected" },
          { "value": "-am", "when": ["nestedProjectSelected", "suiteSelected"] },
          { "value": "-Dtest=${test.suite}", "when": ["suiteSelected", "noCaseSelected"] },
          { "value": "-Dtest=${test.suite}#${test.case}", "when": ["suiteSelected", "caseSelected"] },
          { "value": "-Dsurefire.failIfNoSpecifiedTests=false", "when": "suiteSelected" },
          "test"
        ],
        "results": {
          "decoder": "junitXml",
          "reports": ["target/surefire-reports/TEST-*.xml", "target/failsafe-reports/TEST-*.xml"]
        }
      },
      "diagnostics": {
        "decoder": "lineMatcher",
        "patterns": [
          {
            "regex": "^\\[(ERROR|WARNING)\\] (.+?\\.(?:java|kt|groovy|scala)):\\[(\\d+),(\\d+)\\] (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": { "ERROR": "error", "WARNING": "warning" }
          },
          {
            "regex": "^\\[(ERROR|WARNING)\\] file://(.+?\\.kts?):(\\d+):(\\d+) (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": { "ERROR": "error", "WARNING": "warning" }
          }
        ]
      },
      "dependencies": { "source": "provider", "scopes": ["workspace", "project"] },
      "sync": { "watch": [".mvn/extensions.xml", ".mvn/maven.config", "pom.xml"] },
      "layout": { "excluded": ["target"] }
    }
  ],
  "projectGenerators": [
    {
      "id": "maven-java",
      "displayName": "Maven",
      "description": "A Java project built with Maven.",
      "section": "project",
      "order": 20,
      "icon": { "path": "icons/maven-project.svg", "darkPath": "icons/maven-project_dark.svg", "mode": "original" },
      "fields": [
        {
          "id": "jdk",
          "type": "runtime",
          "title": "JDK",
          "runtime": "java",
          "minimumVersion": "11"
        },
        {
          "id": "addSampleCode",
          "type": "boolean",
          "title": "Add sample code",
          "default": true
        },
        {
          "id": "groupId",
          "type": "text",
          "title": "GroupId",
          "description": "Usually the reversed domain name of your organization, such as com.example.",
          "advanced": true,
          "default": "org.example",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        },
        {
          "id": "artifactId",
          "type": "text",
          "title": "ArtifactId",
          "description": "The name of the artifact the build produces.",
          "advanced": true,
          "default": "${project.name}",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200
        }
      ],
      "requirements": [
        { "languageID": "java" },
        { "buildSystemID": "maven" }
      ],
      "steps": [
        { "kind": "files", "source": "templates/java/maven" },
        {
          "kind": "files",
          "source": "templates/java/standard-sample",
          "when": { "field": "addSampleCode", "equals": true }
        },
        {
          "kind": "files",
          "source": "templates/java/standard-sample-main",
          "target": "src/main/java/${field.groupId|package|path}",
          "when": { "field": "addSampleCode", "equals": true }
        },
        {
          "kind": "files",
          "source": "templates/java/standard-empty",
          "when": { "field": "addSampleCode", "equals": false }
        }
      ],
      "openFiles": [
        {
          "path": "src/main/java/${field.groupId|package|path}/Main.java",
          "when": { "field": "addSampleCode", "equals": true }
        }
      ]
    },
    {
      "id": "maven-archetype",
      "displayName": "Maven Archetype",
      "description": "A project generated by Maven from an archetype.",
      "section": "generator",
      "order": 10,
      "icon": { "path": "icons/maven-project.svg", "darkPath": "icons/maven-project_dark.svg", "mode": "original" },
      "fields": [
        {
          "id": "jdk",
          "type": "runtime",
          "title": "JDK",
          "description": "Maven runs with this JDK, and the new project uses it.",
          "runtime": "java",
          "minimumVersion": "11"
        },
        {
          "id": "archetype",
          "type": "enum",
          "title": "Archetype",
          "presentation": "menu",
          "default": "maven-archetype-quickstart",
          "options": [
            { "value": "maven-archetype-quickstart", "title": "maven-archetype-quickstart" },
            { "value": "maven-archetype-webapp", "title": "maven-archetype-webapp" },
            { "value": "maven-archetype-simple", "title": "maven-archetype-simple" },
            { "value": "maven-archetype-j2ee-simple", "title": "maven-archetype-j2ee-simple" },
            { "value": "maven-archetype-plugin", "title": "maven-archetype-plugin" },
            { "value": "maven-archetype-archetype", "title": "maven-archetype-archetype" },
            { "value": "maven-archetype-site-simple", "title": "maven-archetype-site-simple" },
            { "value": "custom", "title": "Custom archetype…" }
          ]
        },
        {
          "id": "archetypeGroupId",
          "type": "text",
          "title": "Archetype GroupId",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*",
          "maxLength": 200,
          "placeholder": "org.example.archetypes",
          "visibleWhen": { "field": "archetype", "equals": "custom" }
        },
        {
          "id": "archetypeArtifactId",
          "type": "text",
          "title": "Archetype ArtifactId",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200,
          "placeholder": "my-archetype",
          "visibleWhen": { "field": "archetype", "equals": "custom" }
        },
        {
          "id": "archetypeVersion",
          "type": "text",
          "title": "Archetype version",
          "description": "Leave empty to use the latest version Maven finds in its catalog.",
          "optional": true,
          "pattern": "[A-Za-z0-9_.-]+",
          "maxLength": 64,
          "placeholder": "Latest"
        },
        {
          "id": "groupId",
          "type": "text",
          "title": "GroupId",
          "advanced": true,
          "default": "org.example",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        },
        {
          "id": "artifactId",
          "type": "text",
          "title": "ArtifactId",
          "advanced": true,
          "default": "${project.name}",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200
        },
        {
          "id": "version",
          "type": "text",
          "title": "Version",
          "advanced": true,
          "default": "1.0-SNAPSHOT",
          "pattern": "[A-Za-z0-9_.-]+",
          "maxLength": 64
        },
        {
          "id": "packageName",
          "type": "text",
          "title": "Package",
          "advanced": true,
          "default": "${field.groupId}.${field.artifactId|package}",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        }
      ],
      "requirements": [
        { "languageID": "java" },
        { "buildSystemID": "maven" }
      ],
      "steps": [
        {
          "kind": "command",
          "command": "mvn",
          "arguments": [
            "-B",
            "org.apache.maven.plugins:maven-archetype-plugin:3.3.1:generate",
            "-DinteractiveMode=false",
            { "value": "-DarchetypeGroupId=org.apache.maven.archetypes", "when": { "field": "archetype", "notEquals": "custom" } },
            { "value": "-DarchetypeArtifactId=${field.archetype}", "when": { "field": "archetype", "notEquals": "custom" } },
            { "value": "-DarchetypeGroupId=${field.archetypeGroupId}", "when": { "field": "archetype", "equals": "custom" } },
            { "value": "-DarchetypeArtifactId=${field.archetypeArtifactId}", "when": { "field": "archetype", "equals": "custom" } },
            { "value": "-DarchetypeVersion=${field.archetypeVersion}", "when": { "field": "archetypeVersion", "notEquals": "" } },
            "-DgroupId=${field.groupId}",
            "-DartifactId=${field.artifactId}",
            "-Dversion=${field.version}",
            "-Dpackage=${field.packageName}"
          ],
          "environment": { "JAVA_HOME": "${field.jdk}" },
          "collect": "${field.artifactId}",
          "mayUseNetwork": true,
          "timeoutSeconds": 900
        }
      ],
      "openFiles": ["pom.xml"]
    }
  ]
}
