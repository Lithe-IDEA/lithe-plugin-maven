{
  "schemaVersion": 2,
  "id": "io.github.lithe-idea.maven-build",
  "displayName": "Maven",
  "version": "0.1.1",
  "pluginAPIVersion": 3,
  "requires": { "buildProviders": 9, "buildModelInputs": 1, "buildSystems": 3, "executableResolution": 2, "serverProcess": 1 },
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": ["languageServer.launch", "process.build"],
  "activationEvents": ["onBuildSystem:maven"],
  "languages": [],
  "buildSystems": [
    {
      "id": "maven",
      "displayName": "Maven",
      "icon": { "path": "icons/maven.svg" },
      "detection": {
        "markers": ["pom.xml"],
        "nesting": "outermost"
      },
      "invocation": {
        "executables": [{ "kind": "toolchain", "toolchainID": "project-maven" }],
        "runtimeDependencies": [{ "id": "java", "minimumVersion": "8",
          "executables": [{ "kind": "toolchain", "toolchainID": "project-maven-jdk" }] }],
        "globalArguments": [],
        "version": { "arguments": ["--version"], "pattern": "Apache Maven (\\d+\\.\\d+\\.\\d+)" },
        "minimumVersion": "3.6.3"
      },
      "options": [
        {
          "id": "profiles",
          "displayName": "Profiles",
          "kind": "multiSelect", "scope": "instance",
          "choicesFromModel": true,
          "allowCustom": true,
          "presentation": "tree",
          "arguments": ["-P", "${value}"]
        },
        { "id": "settingsFile", "displayName": "Settings File", "kind": "file", "scope": "instance", "arguments": ["-s", "${value}"] },
        {
          "id": "localRepository",
          "displayName": "Local Repository",
          "kind": "directory", "scope": "instance",
          "arguments": ["-Dmaven.repo.local=${value}"]
        },
        {
          "id": "offline",
          "displayName": "Offline",
          "kind": "boolean", "scope": "instance",
          "presentation": "toolbar",
          "icon": { "path": "icons/offline.svg" },
          "arguments": ["-o"]
        },
        {
          "id": "skipTests",
          "displayName": "Skip Tests",
          "kind": "boolean", "scope": "instance",
          "presentation": "toolbar",
          "icon": { "path": "icons/skipTests.svg" },
          "arguments": ["-DskipTests"]
        }
      ],
      "provider": {
        "launch": {
          "kind": "runtime",
          "tool": "java",
          "minimumVersion": "8",
          "entry": "lib/lithe-maven-backend.jar"
        },
        "arguments": ["--state", "${workspaceStateDir}"],
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "model": { "source": "provider" },
      "configuration": { "source": "provider" },
      "modelSharing": { "options": ["profiles", "offline", "skipTests"] },
      "tasks": [
        {
          "id": "java-prepare-run-main",
          "displayName": "resources:resources",
          "group": "build",
          "category": ["Lifecycle"],
          "scopes": ["project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "java-prepare-run-test",
          "displayName": "resources:resources + resources:testResources",
          "group": "build",
          "category": ["Lifecycle"],
          "scopes": ["project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "clean",
          "displayName": "clean",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "validate",
          "displayName": "validate",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "compile",
          "displayName": "compile",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "test",
          "displayName": "test",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "package",
          "displayName": "package",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "verify",
          "displayName": "verify",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "install",
          "displayName": "install",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "site",
          "displayName": "site",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "deploy",
          "displayName": "deploy",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "plugin-goal",
          "displayName": "Plugin Goal",
          "group": "build",
          "category": ["Plugins"],
          "fromModel": true,
          "source": "provider",
          "arguments": []
        },
        {
          "id": "goal",
          "displayName": "Run Maven Goal…",
          "group": "other",
          "scopes": ["workspace", "project"],
          "requiresUserArguments": true,
          "source": "provider",
          "arguments": []
        }
      ],
      "test": {
        "scopes": ["workspace", "project"],
        "filters": ["suite", "case"],
        "selectorKinds": ["java.test.fullName"],
        "source": "provider",
        "arguments": [],
        "results": {
          "decoder": "provider"
        }
      },
      "diagnostics": {
        "decoder": "lineMatcher",
        "patterns": [
          {
            "regex": "^\\[(ERROR|WARNING)\\] (.+?\\.(?:java|kt|groovy|scala)):\\[(\\d+),(\\d+)\\] (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": { "ERROR": "error", "WARNING": "warning" }
          },
          {
            "regex": "^\\[(ERROR|WARNING)\\] file://(.+?\\.kts?):(\\d+):(\\d+) (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": { "ERROR": "error", "WARNING": "warning" }
          }
        ]
      },
      "dependencies": { "source": "provider", "scopes": ["workspace", "project"] },
      "sync": { "watch": [".mvn/extensions.xml", ".mvn/maven.config", ".mvn/jvm.config", ".mvn/wrapper/maven-wrapper.properties", "mvnw", "mvnw.cmd", "pom.xml"] },
      "layout": { "excluded": ["target"] },
      "languageImport": {
        "kind": "maven",
        "options": { "profiles": "profiles", "settingsFile": "settingsFile", "localRepository": "localRepository" }
      }
    }
  ]
}
