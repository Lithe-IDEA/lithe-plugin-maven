{
  "schemaVersion": 0,
  "id": "io.github.lithe-idea.maven-build",
  "displayName": "Maven",
  "version": "1.0.1",
  "pluginAPIVersion": 0,
  "requires": {"buildSystems": 0, "buildProviders": 1, "projectGenerators": 0, "runConfigurationTypes": 0, "beforeLaunchTasks": 0, "settings": 0, "backend": 0, "sourceSettings": 0},
  "vendor": {"id": "io.github.lithe-idea", "displayName": "Lithe Community", "signatureRequirement": "none"},
  "permissions": ["process.build", "project.generate", "backend.launch", "languageServer.launch", "workspace.metadata"],
  "activationEvents": ["onBuildSystem:maven"],
  "settings": [
    {
      "id": "mavenExecutable",
      "type": "file",
      "title": "Maven executable",
      "description": "The mvn program to run. Leave empty to use the project's Maven wrapper (mvnw), then MAVEN_HOME, then mvn on PATH. A path set here is always used, even when the project has a wrapper.",
      "default": "",
      "placeholder": "Automatic: mvnw, MAVEN_HOME, PATH",
      "effect": "reload",
      "page": {"buildSystemID": "maven"},
      "section": "Maven"
    }
  ],
  "buildSystems": [
    {
      "id": "maven",
      "displayName": "Maven",
      "icon": {"path": "icons/maven.svg"},
      "detection": {"markers": ["pom.xml"], "nesting": "outermost"},
      "invocation": {
        "runtimeDependencies": [{"id": "java", "minimumVersion": "8", "executables": [{"kind": "toolchain", "toolchainID": "java"}, {"kind": "environment", "variable": "JAVA_HOME", "path": "bin/java", "platforms": ["macos", "linux"]}, {"kind": "environment", "variable": "JAVA_HOME", "path": "bin/java.exe", "platforms": ["windows"]}, {"kind": "command", "command": "java"}], "version": {"arguments": ["-version"], "pattern": "version \"(?:1\\.)?(\\d+(?:\\.\\d+)*)"}}],
        "executables": [
          {"id": "selected", "kind": "setting", "settingID": "mavenExecutable"},
          {
            "kind": "projectFile",
            "path": "mvnw",
            "requires": [".mvn/wrapper/maven-wrapper.properties"],
            "platforms": ["macos", "linux"]
          },
          {
            "kind": "projectFile",
            "path": "mvnw.cmd",
            "requires": [".mvn/wrapper/maven-wrapper.properties"],
            "platforms": ["windows"]
          },
          {
            "kind": "environment",
            "variable": "MAVEN_HOME",
            "path": "bin/mvn",
            "platforms": ["macos", "linux"]
          },
          {"kind": "environment", "variable": "MAVEN_HOME", "path": "bin/mvn.cmd", "platforms": ["windows"]},
          {"kind": "command", "command": "mvn"}
        ],
        "environmentInputs": ["MAVEN_HOME", "JAVA_HOME"],
        "globalArguments": [
          "-B",
          "-ntp",
          "-Dstyle.color=always",
          "${optionArguments:profiles}",
          "${optionArguments:settingsFile}",
          "${optionArguments:localRepository}",
          "${optionArguments:offline}"
        ],
        "version": {"arguments": ["--version"], "pattern": "Apache Maven (\\d+\\.\\d+\\.\\d+)"},
        "minimumVersion": "3.6.3"
      },
      "options": [
        {
          "id": "profiles",
          "displayName": "Profiles",
          "kind": "multiSelect",
          "choicesFromModel": true,
          "allowCustom": true,
          "presentation": "tree",
          "arguments": ["-P", "${value}"]
        },
        {
          "id": "settingsFile",
          "displayName": "Settings File",
          "kind": "file",
          "arguments": ["-s", "${value}"]
        },
        {
          "id": "localRepository",
          "displayName": "Local Repository",
          "kind": "directory",
          "arguments": ["-Dmaven.repo.local=${value}"]
        },
        {
          "id": "offline",
          "displayName": "Offline",
          "kind": "boolean",
          "presentation": "toolbar",
          "icon": {"path": "icons/offline.svg"},
          "arguments": ["-o"]
        },
        {
          "id": "skipTests",
          "displayName": "Skip Tests",
          "kind": "boolean",
          "presentation": "toolbar",
          "icon": {"path": "icons/skipTests.svg"},
          "arguments": ["-DskipTests"]
        }
      ],
      "model": {
        "source": "command",
        "arguments": [
          "-Dmaven.ext.class.path=${pluginDir}/lib/lithe-maven-extension.jar",
          "-Dlithe.modelOutput=${outputFile}",
          "pre-clean"
        ],
        "output": "outputFile",
        "decoder": "litheBuildModel",
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "tasks": [
        {
          "id": "clean",
          "displayName": "clean",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "clean"
          ]
        },
        {
          "id": "validate",
          "displayName": "validate",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "validate"
          ]
        },
        {
          "id": "compile",
          "displayName": "compile",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "compile"
          ]
        },
        {
          "id": "test",
          "displayName": "test",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "test"
          ]
        },
        {
          "id": "package",
          "displayName": "package",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "package"
          ]
        },
        {
          "id": "verify",
          "displayName": "verify",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "verify"
          ]
        },
        {
          "id": "install",
          "displayName": "install",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "install"
          ]
        },
        {
          "id": "site",
          "displayName": "site",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "site"
          ]
        },
        {
          "id": "deploy",
          "displayName": "deploy",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "deploy"
          ]
        },
        {
          "id": "plugin-goal",
          "displayName": "Plugin Goal",
          "group": "build",
          "category": ["Plugins"],
          "fromModel": true,
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "${task.property:goal}"
          ]
        },
        {
          "id": "goal",
          "displayName": "Run Maven Goal…",
          "group": "other",
          "scopes": ["workspace", "project"],
          "requiresUserArguments": true,
          "arguments": [
            {"value": "-pl", "when": "nestedProjectSelected"},
            {"value": "${project.path}", "when": "nestedProjectSelected"},
            "${optionArguments:skipTests}",
            "${userArguments}"
          ]
        }
      ],
      "test": {
        "scopes": ["workspace", "project"],
        "filters": ["suite", "case"],
        "arguments": [
          {"value": "-pl", "when": "nestedProjectSelected"},
          {"value": "${project.path}", "when": "nestedProjectSelected"},
          {
            "value": "-am",
            "when": ["nestedProjectSelected", "suiteSelected"]
          },
          {"value": "-Dtest=${test.suite}", "when": ["suiteSelected", "noCaseSelected"]},
          {"value": "-Dtest=${test.suite}#${test.case}", "when": ["suiteSelected", "caseSelected"]},
          {"value": "-Dsurefire.failIfNoSpecifiedTests=false", "when": "suiteSelected"},
          "test"
        ],
        "results": {
          "decoder": "junitXml",
          "reports": ["target/surefire-reports/TEST-*.xml", "target/failsafe-reports/TEST-*.xml"]
        }
      },
      "diagnostics": {
        "decoder": "lineMatcher",
        "patterns": [
          {
            "regex": "^\\[(ERROR|WARNING)\\] (.+?\\.(?:java|kt|groovy|scala)):\\[(\\d+),(\\d+)\\] (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": {"ERROR": "error", "WARNING": "warning"}
          },
          {
            "regex": "^\\[(ERROR|WARNING)\\] file://(.+?\\.kts?):(\\d+):(\\d+) (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": {"ERROR": "error", "WARNING": "warning"}
          }
        ]
      },
      "dependencies": {
        "source": "command",
        "scopes": ["workspace", "project"],
        "arguments": [
          "-Dmaven.ext.class.path=${pluginDir}/lib/lithe-maven-extension.jar",
          "-Dlithe.dependenciesOutput=${outputFile}",
          {"value": "-Dlithe.dependenciesProject=./${project.path}", "when": "projectSelected"},
          "pre-clean"
        ],
        "output": "outputFile",
        "decoder": "litheDependencies",
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "sync": {
        "watch": [".mvn/extensions.xml", ".mvn/maven.config", "pom.xml"]
      },
      "layout": {"excluded": ["target"]},
      "provider": {
        "launch": {"kind": "runtime", "tool": "java", "minimumVersion": "8", "entry": "lib/lithe-maven-provider.jar", "runtimeArguments": ["-Xms16m", "-Xmx96m"]},
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "runConfigurationTypes": [
        {
          "id": "maven",
          "displayName": "Maven",
          "description": "Runs Maven goals, lifecycle phases and options with mvn.",
          "icon": {
            "path": "icons/maven.svg"
          },
          "execution": "task",
          "fields": [
            {
              "id": "goals",
              "title": "Command line",
              "description": "Maven goals, phases and options to run, such as clean package or test -Dtest=MyTest.",
              "kind": "arguments",
              "placeholder": "clean package",
              "required": true
            },
            {
              "id": "profiles",
              "title": "Profiles",
              "description": "Comma-separated Maven profiles to activate, or prefix with ! or - to deactivate, passed as -P.",
              "kind": "text",
              "placeholder": "dev, -integration",
              "arguments": [
                "-P",
                "${value}"
              ]
            },
            {
              "id": "skipTests",
              "title": "Skip tests",
              "description": "Pass -DskipTests so test sources are compiled without running the tests.",
              "kind": "checkbox",
              "arguments": [
                "-DskipTests"
              ]
            },
            {
              "id": "offline",
              "title": "Work offline",
              "description": "Pass -o so Maven resolves dependencies only from the local repository.",
              "kind": "checkbox",
              "arguments": [
                "-o"
              ]
            }
          ],
          "arguments": [
            "${field:goals}",
            "${field:profiles}",
            "${field:skipTests}",
            "${field:offline}"
          ]
        }
      ],
      "beforeLaunchTasks": [
        {
          "id": "goal",
          "displayName": "Run Maven Goal",
          "description": "Runs Maven goals or phases, such as compile or test-compile, in the configuration's working directory before launch.",
          "icon": {
            "path": "icons/maven.svg"
          },
          "fields": [
            {
              "id": "goals",
              "title": "Command line",
              "description": "Maven goals, phases and options to run before launch, such as compile or package -DskipTests.",
              "kind": "arguments",
              "placeholder": "compile",
              "required": true
            }
          ],
          "arguments": [
            "${field:goals}"
          ]
        }
      ],
      "run": [
        {"id": "spring-boot", "source": "provider", "fromTargets": {"tags": ["spring-boot"]}, "execution": "service", "debug": {"configurationType": "java"}},
        {"id": "application", "source": "provider", "fromTargets": {"tags": ["java-application"]}, "execution": "application"},
        {"id": "main", "source": "provider", "entrypoints": true}
      ]
    }
  ],
  "projectGenerators": [
    {
      "id": "maven-java",
      "displayName": "Maven",
      "description": "A Java project built with Maven.",
      "section": "project",
      "order": 20,
      "icon": {"path": "icons/maven-project.svg", "darkPath": "icons/maven-project_dark.svg", "mode": "original"},
      "fields": [
        {
          "id": "javaRelease",
          "type": "enum",
          "title": "Java release",
          "description": "The Java release the project compiles for (maven.compiler.release). The JDK that runs Maven must support it.",
          "presentation": "menu",
          "default": "17",
          "options": [
            {"value": "8", "title": "8"},
            {"value": "11", "title": "11"},
            {"value": "17", "title": "17"},
            {"value": "21", "title": "21"},
            {"value": "25", "title": "25"}
          ]
        },
        {"id": "addSampleCode", "type": "boolean", "title": "Add sample code", "default": true},
        {
          "id": "groupId",
          "type": "text",
          "title": "GroupId",
          "description": "Usually the reversed domain name of your organization, such as com.example.",
          "advanced": true,
          "default": "org.example",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        },
        {
          "id": "artifactId",
          "type": "text",
          "title": "ArtifactId",
          "description": "The name of the artifact the build produces.",
          "advanced": true,
          "default": "${project.name}",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200
        }
      ],
      "requirements": [{"languageID": "java"}, {"buildSystemID": "maven"}],
      "steps": [
        {"kind": "files", "source": "templates/java/maven"},
        {
          "kind": "files",
          "source": "templates/java/standard-sample",
          "when": {"field": "addSampleCode", "equals": true}
        },
        {
          "kind": "files",
          "source": "templates/java/standard-sample-main",
          "target": "src/main/java/${field.groupId|package|path}",
          "when": {"field": "addSampleCode", "equals": true}
        },
        {
          "kind": "files",
          "source": "templates/java/standard-empty",
          "when": {"field": "addSampleCode", "equals": false}
        }
      ],
      "openFiles": [
        {
          "path": "src/main/java/${field.groupId|package|path}/Main.java",
          "when": {"field": "addSampleCode", "equals": true}
        }
      ]
    },
    {
      "id": "maven-archetype",
      "displayName": "Maven Archetype",
      "description": "A project generated by Maven from an archetype.",
      "section": "generator",
      "order": 10,
      "icon": {"path": "icons/maven-project.svg", "darkPath": "icons/maven-project_dark.svg", "mode": "original"},
      "fields": [
        {
          "id": "archetype",
          "type": "enum",
          "title": "Archetype",
          "presentation": "menu",
          "default": "maven-archetype-quickstart",
          "options": [
            {"value": "maven-archetype-quickstart", "title": "maven-archetype-quickstart"},
            {"value": "maven-archetype-webapp", "title": "maven-archetype-webapp"},
            {"value": "maven-archetype-simple", "title": "maven-archetype-simple"},
            {"value": "maven-archetype-j2ee-simple", "title": "maven-archetype-j2ee-simple"},
            {"value": "maven-archetype-plugin", "title": "maven-archetype-plugin"},
            {"value": "maven-archetype-archetype", "title": "maven-archetype-archetype"},
            {"value": "maven-archetype-site-simple", "title": "maven-archetype-site-simple"},
            {"value": "custom", "title": "Custom archetype…"}
          ]
        },
        {
          "id": "archetypeGroupId",
          "type": "text",
          "title": "Archetype GroupId",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*",
          "maxLength": 200,
          "placeholder": "org.example.archetypes",
          "visibleWhen": {"field": "archetype", "equals": "custom"}
        },
        {
          "id": "archetypeArtifactId",
          "type": "text",
          "title": "Archetype ArtifactId",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200,
          "placeholder": "my-archetype",
          "visibleWhen": {"field": "archetype", "equals": "custom"}
        },
        {
          "id": "archetypeVersion",
          "type": "text",
          "title": "Archetype version",
          "description": "Leave empty to use the latest version Maven finds in its catalog.",
          "optional": true,
          "pattern": "[A-Za-z0-9_.-]+",
          "maxLength": 64,
          "placeholder": "Latest"
        },
        {
          "id": "groupId",
          "type": "text",
          "title": "GroupId",
          "advanced": true,
          "default": "org.example",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        },
        {
          "id": "artifactId",
          "type": "text",
          "title": "ArtifactId",
          "advanced": true,
          "default": "${project.name}",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200
        },
        {
          "id": "version",
          "type": "text",
          "title": "Version",
          "advanced": true,
          "default": "1.0-SNAPSHOT",
          "pattern": "[A-Za-z0-9_.-]+",
          "maxLength": 64
        },
        {
          "id": "packageName",
          "type": "text",
          "title": "Package",
          "advanced": true,
          "default": "${field.groupId}.${field.artifactId|package}",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        }
      ],
      "requirements": [{"languageID": "java"}, {"buildSystemID": "maven"}],
      "steps": [
        {
          "kind": "command",
          "command": "mvn",
          "arguments": [
            "-B",
            "org.apache.maven.plugins:maven-archetype-plugin:3.3.1:generate",
            "-DinteractiveMode=false",
            {
              "value": "-DarchetypeGroupId=org.apache.maven.archetypes",
              "when": {"field": "archetype", "notEquals": "custom"}
            },
            {
              "value": "-DarchetypeArtifactId=${field.archetype}",
              "when": {"field": "archetype", "notEquals": "custom"}
            },
            {
              "value": "-DarchetypeGroupId=${field.archetypeGroupId}",
              "when": {"field": "archetype", "equals": "custom"}
            },
            {
              "value": "-DarchetypeArtifactId=${field.archetypeArtifactId}",
              "when": {"field": "archetype", "equals": "custom"}
            },
            {
              "value": "-DarchetypeVersion=${field.archetypeVersion}",
              "when": {"field": "archetypeVersion", "notEquals": ""}
            },
            "-DgroupId=${field.groupId}",
            "-DartifactId=${field.artifactId}",
            "-Dversion=${field.version}",
            "-Dpackage=${field.packageName}"
          ],
          "collect": "${field.artifactId}",
          "mayUseNetwork": true,
          "timeoutSeconds": 900
        }
      ],
      "openFiles": ["pom.xml"]
    }
  ],
  "requiresTools": ["java"],
  "backend": {"launch": {"kind": "runtime", "tool": "java", "minimumVersion": "8", "entry": "lib/lithe-maven-settings.jar", "runtimeArguments": ["-Xms16m", "-Xmx96m"]}},
  "settingActions": [{"id": "compiler", "title": "Read compiler settings", "description": "Read actual project settings using the project tool. This can execute project code and download dependencies. Save writes the displayed native configuration files.", "function": "compiler.settings", "sourceEditor": {"editFunction": "compiler.prepareSettings", "buildSystemID": "maven"}, "page": {"compilerID": "maven"}}, {"id": "libraries", "title": "Read local JAR dependencies", "description": "Read actual project settings using the project tool. This can execute project code and download dependencies. Save writes the displayed native configuration files.", "function": "libraries.settings", "sourceEditor": {"editFunction": "compiler.prepareSettings", "buildSystemID": "maven"}, "page": {"buildSystemID": "maven"}}],
  "settingRegions": [
    {
      "id": "build",
      "page": {
        "buildSystemID": "maven"
      },
      "keywords": [
        "mvn",
        "mvnw",
        "Maven Wrapper",
        "MAVEN_HOME",
        "pom.xml",
        "settings.xml",
        "localRepository",
        ".m2",
        "profiles",
        "dependencies"
      ]
    },
    {
      "id": "compiler",
      "page": {
        "compilerID": "maven"
      },
      "keywords": [
        "maven-compiler-plugin",
        "javac",
        "release",
        "source",
        "target",
        "encoding"
      ]
    }
  ]
}
