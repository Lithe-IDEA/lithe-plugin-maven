{
  "schemaVersion": 2,
  "id": "io.github.lithe-idea.maven-build",
  "displayName": "Maven",
  "version": "0.1.1",
  "pluginAPIVersion": 3,
  "requires": { "buildProviders": 11, "buildModelInputs": 1, "buildSystems": 4, "executableResolution": 2, "toolDefinitions": 1, "serverProcess": 1 },
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": ["languageServer.launch", "process.build"],
  "activationEvents": ["onBuildSystem:maven"],
  "languages": [],
  "toolDefinitions": [
    {
      "id": "io.github.lithe-idea.maven-build:maven",
      "displayName": "Maven",
      "icon": {
        "path": "icons/maven.svg"
      },
      "executableLayouts": [
        {
          "path": "bin/mvn",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "path": "bin/mvn.cmd",
          "platforms": [
            "windows"
          ]
        }
      ],
      "executables": [
        {
          "id": "pinned",
          "kind": "setting",
          "settingID": "executable",
          "layer": "project"
        },
        {
          "id": "wrapper",
          "kind": "projectFile",
          "path": "mvnw",
          "requires": [
            ".mvn/wrapper/maven-wrapper.properties"
          ],
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "id": "wrapper-windows",
          "kind": "projectFile",
          "path": "mvnw.cmd",
          "requires": [
            ".mvn/wrapper/maven-wrapper.properties"
          ],
          "platforms": [
            "windows"
          ]
        },
        {
          "id": "project-request",
          "kind": "toolchain",
          "scope": "project"
        },
        {
          "id": "default",
          "kind": "setting",
          "settingID": "executable",
          "layer": "global"
        },
        {
          "id": "global-request",
          "kind": "toolchain",
          "scope": "global"
        },
        {
          "id": "home",
          "kind": "environment",
          "variable": "MAVEN_HOME",
          "path": "bin/mvn",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "id": "home-windows",
          "kind": "environment",
          "variable": "MAVEN_HOME",
          "path": "bin/mvn.cmd",
          "platforms": [
            "windows"
          ]
        },
        {
          "id": "shell",
          "kind": "command",
          "command": "mvn"
        },
        {
          "id": "installed",
          "kind": "toolchain",
          "scope": "installed"
        }
      ],
      "version": {
        "arguments": [
          "--version"
        ],
        "pattern": "Apache Maven (\\d+(?:\\.\\d+)*)"
      },
      "homeVariable": "MAVEN_HOME",
      "commands": [
        "mvn"
      ],
      "wrappers": [
        {
          "path": "mvnw",
          "requires": [
            ".mvn/wrapper/maven-wrapper.properties"
          ],
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "path": "mvnw.cmd",
          "requires": [
            ".mvn/wrapper/maven-wrapper.properties"
          ],
          "platforms": [
            "windows"
          ]
        }
      ],
      "exports": [
        {
          "name": "MAVEN_HOME",
          "value": "${home}"
        }
      ],
      "pathPrepend": [
        "${home}/bin"
      ],
      "launch": [
        "${executable}",
        "${arguments}"
      ]
    }
  ],
  "buildSystems": [
    {
      "id": "maven",
      "displayName": "Maven",
      "icon": { "path": "icons/maven.svg" },
      "detection": {
        "markers": ["pom.xml"],
        "nesting": "outermost"
      },
      "invocation": {
        "executables": [{ "kind": "toolchain", "toolchainID": "io.github.lithe-idea.maven-build:maven" }],
        "runtimeDependencies": [{ "id": "java", "minimumVersion": "8",
          "executables": [{ "kind": "toolchain", "toolchainID": "java" }] }],
        "globalArguments": [],
        "version": { "arguments": ["--version"], "pattern": "Apache Maven (\\d+\\.\\d+\\.\\d+)" },
        "minimumVersion": "3.6.3"
      },
      "run": [
        {
          "id": "framework",
          "debug": {"configurationType": "java"},
          "source": "provider",
          "name": "Run Maven service",
          "execution": "service",
          "fromTargets": {
            "tags": [
              "maven-service"
            ]
          }
        },
        {
          "id": "module",
          "source": "provider",
          "name": "Run Maven goals",
          "execution": "task",
          "fromTargets": {
            "tags": [
              "maven-module"
            ]
          }
        }
      ],
      "options": [
        {
          "id": "profiles",
          "displayName": "Profiles",
          "kind": "multiSelect", "scope": "instance",
          "choicesFromModel": true,
          "allowCustom": true,
          "presentation": "tree",
          "arguments": ["-P", "${value}"]
        },
        { "id": "settingsFile", "displayName": "Settings File", "kind": "file", "scope": "instance", "arguments": ["-s", "${value}"] },
        {
          "id": "localRepository",
          "displayName": "Local Repository",
          "kind": "directory", "scope": "instance",
          "arguments": ["-Dmaven.repo.local=${value}"]
        },
        {
          "id": "offline",
          "displayName": "Offline",
          "kind": "boolean", "scope": "instance",
          "presentation": "toolbar",
          "icon": { "path": "icons/offline.svg" },
          "arguments": ["-o"]
        },
        {
          "id": "skipTests",
          "displayName": "Skip Tests",
          "kind": "boolean", "scope": "instance",
          "presentation": "toolbar",
          "icon": { "path": "icons/skipTests.svg" },
          "arguments": ["-DskipTests"]
        }
      ],
      "provider": {
        "launch": {
          "kind": "runtime",
          "tool": "java",
          "minimumVersion": "8",
          "entry": "lib/lithe-maven-backend.jar"
        },
        "arguments": ["--state", "${workspaceStateDir}"],
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "model": { "source": "provider" },
      "configuration": { "source": "provider" },
      "modelSharing": { "options": ["profiles", "offline", "skipTests"] },
      "tasks": [
        {
          "id": "java-prepare-run-main",
          "preparation": { "purpose": "run", "sourceRoles": ["source", "generatedSource", "resource"] },
          "displayName": "resources:resources",
          "group": "build",
          "category": ["Lifecycle"],
          "scopes": ["project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "java-prepare-run-test",
          "preparation": { "purpose": "run", "sourceRoles": ["testSource", "generatedTestSource", "testResource"] },
          "displayName": "resources:resources + resources:testResources",
          "group": "build",
          "category": ["Lifecycle"],
          "scopes": ["project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "clean",
          "displayName": "clean",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "validate",
          "displayName": "validate",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "compile",
          "displayName": "compile",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "test",
          "displayName": "test",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "package",
          "displayName": "package",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "verify",
          "displayName": "verify",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "install",
          "displayName": "install",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "site",
          "displayName": "site",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "deploy",
          "displayName": "deploy",
          "group": "lifecycle",
          "category": ["Lifecycle"],
          "scopes": ["workspace", "project"],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "plugin-goal",
          "displayName": "Plugin Goal",
          "group": "build",
          "category": ["Plugins"],
          "fromModel": true,
          "source": "provider",
          "arguments": []
        },
        {
          "id": "goal",
          "displayName": "Run Maven Goal…",
          "group": "other",
          "scopes": ["workspace", "project"],
          "requiresUserArguments": true,
          "source": "provider",
          "arguments": []
        }
      ],
      "test": {
        "scopes": ["workspace", "project"],
        "filters": ["suite", "case"],
        "selectorKinds": ["java.test.fullName"],
        "source": "provider",
        "arguments": [],
        "results": {
          "decoder": "provider"
        }
      },
      "diagnostics": {
        "decoder": "lineMatcher",
        "patterns": [
          {
            "regex": "^\\[(ERROR|WARNING)\\] (.+?\\.(?:java|kt|groovy|scala)):\\[(\\d+),(\\d+)\\] (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": { "ERROR": "error", "WARNING": "warning" }
          },
          {
            "regex": "^\\[(ERROR|WARNING)\\] file://(.+?\\.kts?):(\\d+):(\\d+) (.+)$",
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5,
            "severity": 1,
            "severities": { "ERROR": "error", "WARNING": "warning" }
          }
        ]
      },
      "dependencies": { "source": "provider", "scopes": ["workspace", "project"] },
      "sync": { "watch": [".mvn/extensions.xml", ".mvn/maven.config", ".mvn/jvm.config", ".mvn/wrapper/maven-wrapper.properties", "mvnw", "mvnw.cmd", "pom.xml"] },
      "layout": { "excluded": ["target"] },
      "languageImport": {
        "kind": "maven",
        "options": { "profiles": "profiles", "settingsFile": "settingsFile", "localRepository": "localRepository" }
      }
    }
  ]
}
