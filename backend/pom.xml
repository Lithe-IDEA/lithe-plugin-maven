<?xml version="1.0" encoding="UTF-8"?>
<!--
  The build provider Lithe starts for Maven workspaces: a long-lived Java
  process that answers lithe/build/model and lithe/build/dependencies from a
  persistent snapshot, and runs Maven (with the extension in ../extension)
  only when the snapshot is missing, stale or a refresh was asked for.

  Lithe's Java plugin SDK is not published to a Maven repository.
  scripts/package.mjs downloads the JAR pinned in sdk.lock.json, checks its
  SHA-256 and passes it as -Dlithe.sdk.jar. It compiles against that file and
  shade's extraJars merges it into lithe-maven-backend.jar, so the package
  carries one self-contained JAR and nothing is installed into ~/.m2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.lithe-idea</groupId>
  <artifactId>lithe-maven-backend</artifactId>
  <!-- Kept equal to plugin.json's version; scripts/package.mjs checks it. -->
  <version>0.1.1</version>
  <packaging>jar</packaging>
  <name>Lithe Maven build provider</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- plugin.json launches it with any Java 8 or newer. -->
    <maven.compiler.release>8</maven.compiler.release>
    <!-- A fixed timestamp makes the jar byte-for-byte reproducible. -->
    <project.build.outputTimestamp>2026-10-20T00:00:00Z</project.build.outputTimestamp>
    <!-- Absolute path of the checked SDK JAR; set by scripts/package.mjs. -->
    <lithe.sdk.jar>${project.basedir}/missing-lithe-sdk.jar</lithe.sdk.jar>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.lithe-idea</groupId>
      <artifactId>lithe-plugin-sdk-java</artifactId>
      <version>0.1.0</version>
      <scope>system</scope>
      <systemPath>${lithe.sdk.jar}</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>lithe-maven-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Shade leaves system-scoped artifacts out; this merges the SDK in. -->
              <extraJars>
                <extraJar>${lithe.sdk.jar}</extraJar>
              </extraJars>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.litheidea.maven.backend.MavenBackend</mainClass>
                  <manifestEntries>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
